# .NET build output
bin/
obj/
*.user

# Native build artifacts (Go cffi wrapper lives in client/native)
client/native/*.h
client/native/*.so
client/native/*.dll
client/native/*.dylib
client/native/go.sum

# The compiled native libraries are produced locally and dropped here.
# Track the folder layout but not the (large, platform-specific) binaries.
client/JAHTTPClient/runtimes/**/*.dll
client/JAHTTPClient/runtimes/**/*.so
client/JAHTTPClient/runtimes/**/*.dylib
client/JAHTTPClient/runtimes/**/*.h

# Exception: the prebuilt linux-x64 native library is committed on purpose so the
# library runs out of the box on linux-x64 without a local Go/CGO build.
!client/JAHTTPClient/runtimes/linux-x64/native/tls-client-linux-amd64.so

# Exception: the cross-built win-x64 native engine is committed too, so a Windows
# exe can be produced with `dotnet publish -r win-x64` without a local Go/mingw build.
!client/JAHTTPClient/runtimes/win-x64/native/tls-client-windows-64.dll

# IDE
.vs/
.idea/
*.swp

# local test artifacts
/ca.cer
/ca.pem
/*.saz
/Project.zip

# Publish output and packaged builds (regenerable via `dotnet publish`; large).
/dist-win/
/dist-linux/
/JASniffer-win-x64/
/JASniffer-win-x64.zip
