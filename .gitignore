# .NET build output
bin/
obj/
*.user

# Native build artifacts
native/*.h
native/*.so
native/*.dll
native/*.dylib

# The compiled native libraries are produced locally and dropped here.
# Track the folder layout but not the (large, platform-specific) binaries.
src/JAHTTPClient/runtimes/**/*.dll
src/JAHTTPClient/runtimes/**/*.so
src/JAHTTPClient/runtimes/**/*.dylib
src/JAHTTPClient/runtimes/**/*.h

# Exception: the prebuilt linux-x64 native library is committed on purpose so the
# library runs out of the box on linux-x64 without a local Go/CGO build.
!src/JAHTTPClient/runtimes/linux-x64/native/tls-client-linux-amd64.so

# Go
native/go.sum

# IDE
.vs/
.idea/
*.swp

# local test artifacts
/ca.cer
/ca.pem
/*.saz
/Project.zip
