# .NET build output
bin/
obj/
*.user

# Native build artifacts
native/*.h
native/*.so
native/*.dll
native/*.dylib

# The compiled native libraries are produced locally and dropped here.
# Track the folder layout but not the (large, platform-specific) binaries.
src/JAHTTPClient/runtimes/**/*.dll
src/JAHTTPClient/runtimes/**/*.so
src/JAHTTPClient/runtimes/**/*.dylib
src/JAHTTPClient/runtimes/**/*.h

# Exception: the prebuilt linux-x64 native library is committed on purpose so the
# library runs out of the box on linux-x64 without a local Go/CGO build.
!src/JAHTTPClient/runtimes/linux-x64/native/tls-client-linux-amd64.so

# Exception: the cross-built win-x64 native engine is committed too, so a Windows
# exe can be produced with `dotnet publish -r win-x64` without a local Go/mingw build.
!src/JAHTTPClient/runtimes/win-x64/native/tls-client-windows-64.dll

# Go
native/go.sum

# IDE
.vs/
.idea/
*.swp

# local test artifacts
/ca.cer
/ca.pem
/*.saz
/Project.zip

# Publish output (regenerable: produced by `dotnet publish`). The unpacked
# folders are huge; keep them out of git. The packaged JASniffer-win-x64.zip
# (ready-to-run exe + native dll) IS committed below as a release artifact.
/dist-win/
/dist-linux/
/JASniffer-win-x64/
